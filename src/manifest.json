{
  "manifest_version": 3,
  "name": "Skip the Yap!",
  "version": "1.0.1",
  "description": "Turn Messenger and Instagram voice notes into readable transcripts or quick summaries with one click.",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Skip the Yap!",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "permissions": [
    "clipboardWrite",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.messenger.com/*",
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "https://*.fbsbx.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api.elevenlabs.io/*",
    "https://api.openai.com/*",
    "https://api.x.ai/*",
    "https://openrouter.ai/*",
    "https://router.huggingface.co/*",
    "https://huggingface.co/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.messenger.com/*",
        "https://*.facebook.com/messages/*",
        "https://*.instagram.com/direct/*"
      ],
      "js": ["content/page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.messenger.com/*",
        "https://*.facebook.com/messages/*",
        "https://*.instagram.com/direct/*"
      ],
      "js": ["shared/core.js", "content/dom.js", "content/content-script.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
